label.termos-aceite{flex-direction:column-reverse;gap:0;padding:18px}label.termos-aceite>span{text-align:justify;hyphens:auto;word-break:break-word}label.termos-aceite>input{transform:scale(1.4);margin:16px 0 0 0!important;align-self:flex-start}}
