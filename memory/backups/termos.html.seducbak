.seduc-edital-card,.termos-aceite{font-family:"OpenSans-Regular",Helvetica,Arial,sans-serif}.seduc-edital-card .sec-head h3,.seduc-edital-card strong{font-family:"OpenSans-Semibold",Helvetica,Arial,sans-serif}
.seduc-edital-card{border:1px solid #d9e6dd;border-radius:6px;background:#fff;margin:26px 0 22px;box-shadow:0 1px 3px rgba(0,0,0,.06);overflow:hidden;max-width:900px}
.seduc-edital-card .sec-head{background:#008d3c;padding:12px 18px}
.seduc-edital-card .sec-head h3{margin:0;font-size:19px;font-weight:600;color:#fff;line-height:1.35}
.seduc-edital-card .sec-body{padding:18px;display:flex;gap:22px;align-items:center}
.seduc-edital-card .sec-body img{width:210px;height:auto;flex:0 0 auto}
.seduc-edital-card .sec-txt{color:#333;font-size:15px;line-height:1.7}
.termos-aceite{display:flex;gap:14px;align-items:flex-start;cursor:pointer;font-size:15px;line-height:1.6;color:#212529;padding:20px 22px;background:#f4faf6;border:1px solid #d9e6dd;border-radius:8px}
